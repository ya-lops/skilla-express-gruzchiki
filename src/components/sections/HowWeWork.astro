---

<section class="how-we-work py-8 md:py-10 lg:py-20" data-cmp="HowWeWork">
  <div class="container">
    <h2 class="_how-we-work-title pb-16 text-text-primary">Как мы работаем</h2>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
      {
        steps.map((step: any, index: number) => (
          <div class="flex lg:flex-col items-center lg:items-start gap-2 lg:gap-7 p-8 rounded-xl bg-surface-secondary-inverse text-text-primary">
            <div class="flex shrink-0">
              <Fragment set:html={step.image} />
            </div>

            <div class="_content lg:mt-20">
              <div class="_number mb-6 text-left typo-h3 text-text-tertiary">{index + 1}.</div>
              <h3 class="_title typo-t1 text-left balance text-text-primary">{step.title}</h3>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
