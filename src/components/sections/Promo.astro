---
import type { BrandData } from "@/types/brand";
import Button from "../ui/Button.astro";
import IconSvg from "../IconSvg.astro";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;

const discount = brandData.main.adv_price_percent;

const firstServiceUrl = brandData.services[0].url.toLowerCase();
---

<section class="promo bg-promo-surface overflow-clip" data-cmp="Promo">
  <div class="container relative">
    <div class="_promo-inner flex justify-between items-center gap-7 pl-1 pr-3 lg:px-0 lg:gap-15 max-w-[747px] mx-auto">
      <div class="flex items-center gap-5">
        <div
          class="_promo-value w-[68px] h-[42px] flex items-center justify-center rotate-[20deg] rounded-2xl text-text-primary-inverse text-xl font-bold bg-button-surface-accent shadow-[0px_15px_34px_-16px_hsla(220,52%,53%,0.5)]"
        >
          -{discount}%
        </div>

        <div class="_promo-description flex flex-col py-3 lg:py-4">
          <p class="text-promo-text-primary text-md font-bold">Только в сентябре</p>
          <p class="text-promo-text-secondary typo-t4 font-medium">скидка {discount}% на все услуги</p>
        </div>
      </div>

      <div class="_promo-actions py-2 ml-auto lg:ml-0">
        <a href={`/${firstServiceUrl}`} class="flex items-center gap-2.5 text-accent font-bold hover:underline"
          ><span class="hidden lg:block">в каталог услуг</span>
          <IconSvg name="arrow-right" />
        </a>
      </div>
    </div>
  </div>
</section>
