---
import Button from "@/components/ui/Button.astro";

import HeroFeatures from "../blocks/HeroFeatures.astro";

interface Props {
  brandData: any;
  type: "main" | "about";
}

const { brandData, type = "main" } = Astro.props;

import { getGlobalMinPriceWithDiscount, getDiscountPercent } from "@/utils/price";

const discount = getDiscountPercent(brandData.main.adv_price_percent);

const { price, discountedPrice, showDiscount } = getGlobalMinPriceWithDiscount(brandData.services, discount);

const firstServiceUrl = brandData.services[0].url.toLowerCase();
---

{
  type == "main" && (
    <section
      class="hero grid grid-cols-[100%] lg:min-h-[800px] lg:mt-[-140px] lg:pt-[140px] mx-2 lg:mx-4 rounded-t-3xl lg:rounded-t-[60px] add-gradient bg-hero-main-surface text-hero-main-text overflow-clip"
      data-cmp="Hero"
    >
      <div class="container h-full">
        <div class="_hero-inner relative grid grid-cols-1 lg:grid-cols-[3fr_2fr] items-start lg:items-center h-full max-w-[1300px] mx-auto">
          <div class="_hero-content flex flex-col gap-10 py-8 justify-self-center">
            <h1 class="_hero-title typo-h1 text-left text-balance isolate">Исполнители для любых задач</h1>

            <HeroFeatures />

            <div class="_hero-actions flex flex-col lg:flex-row items-start lg:items-center gap-6 lg:gap-8">
              <div class="_hero-actions-items">
                <Button href="#kp" variant="accent" text="Получить КП" />
              </div>
            </div>
          </div>

          <div class="_hero-image justify-self-center">
            <img class="" src="/images/hero-main.webp" alt="" fetchpriority="high" />
          </div>
        </div>
      </div>
    </section>
  )
}

{
  type == "about" && (
    <section
      class="hero grid grid-cols-[100%] lg:min-h-[750px] lg:mt-[-196px] lg:pt-[196px] mx-2 lg:mx-4 rounded-t-3xl lg:rounded-t-[60px] add-gradient bg-hero-about-surface text-hero-about-text overflow-clip isolate"
      data-cmp="Hero"
    >
      <div class="container h-full">
        <div class="_hero-inner relative grid grid-cols-1 lg:grid-cols-2 lg:items-center h-full">
          <div class="_hero-content flex flex-col gap-10 py-8">
            <h1 class="_hero-title typo-h1 text-left text-balance isolate">Лидер в сфере рабочего персонала с 2010 года</h1>

            <p class="max-w-[473px] text-text-secondary typo-t3">
              «Экспресс-Грузчики» — это ведущая компания по аутсорсингу. Плодотворно работает в сфере оказания услуг физическим лицам
              и организациям с 2010 года
            </p>

            <div class="_hero-actions flex items-center gap-8">
              <div class="_hero-actions-items">
                <Button href={`/${firstServiceUrl}`} variant="secondary" text="Наши услуги" />
              </div>
            </div>
          </div>

          <div class="_hero-image justify-self-center">
            <img src="/images/hero-about.webp" alt="" fetchpriority="high" />
          </div>
        </div>
      </div>
    </section>
  )
}
