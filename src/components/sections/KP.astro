---
import type { BrandData } from "@/types/brand";
import KpForm from "../blocks/KpForm.astro";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;
---

<section class="bg-kp-surface overflow-clip" data-cmp="KP">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-[340px_1fr] xl:grid-cols-[4fr_3fr_365px] gap-3 lg:gap-20 isolate">
      <h2 class="order-1 xl:max-w-132 py-5 lg:py-12.5 text-left typo-h3 text-kp-text *:text-kp-text-accent *:not-italic">
        Бесплатно <em>сделаем</em> коммерческое предложение <em>индивидуально под ваши потребности</em>
      </h2>

      <div class="order-last lg:order-2 self-end">
        <img class="relative -z-1 origin-bottom pointer-events-none" src="/images/kp-image.webp" alt="" loading="lazy" />
      </div>

      <div class="order-3">
        <KpForm />
      </div>
    </div>
  </div>
</section>
