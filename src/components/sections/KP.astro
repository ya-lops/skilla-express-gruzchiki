---
import type { BrandData } from "@/types/brand";
import KpForm from "../blocks/KpForm.astro";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;
---

<section id="kp" class="overflow-clip scroll-mt-[100px] py-8 lg:py-20" data-cmp="KP">
  <div class="container bg-kp-surface p-15 rounded-2xl">
    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_1fr_365px] gap-3 lg:gap-6 isolate">
      <h2 class="max-w-[492px] text-left typo-h3 text-kp-text *:text-kp-text-accent *:not-italic">
        Бесплатно <em>сделаем</em> коммерческое предложение <em>индивидуально под ваши потребности</em>
      </h2>

      <div class="self-end origin-bottom pointer-events-none -mb-15">
        <img class="" src="/images/kp-image.webp" alt="" loading="lazy" />
      </div>

      <KpForm />
    </div>
  </div>
</section>
