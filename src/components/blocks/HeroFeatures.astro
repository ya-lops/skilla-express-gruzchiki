---
const features = [
  {
    text: "Низкие цены",
  },
  {
    text: "Трезвые рабочие в течение 1 часа",
  },
  {
    text: "Фиксированная стоимость",
  },
  {
    text: "Отсрочка при крупных заказах",
  },
  {
    text: "26 офисов в России и СНГ",
  },
];
---

<section data-cmp="HeroFeatures">
  <ul>
    {
      features.map((feature) => (
        <li class="typo-t2 flex items-center gap-3 mb-2">
          <span class="w-2 h-2 shrink-0 rounded-full bg-button-surface-accent-inverse"></span>
          <span set:html={feature.text} />
        </li>
      ))
    }
  </ul>
</section>
